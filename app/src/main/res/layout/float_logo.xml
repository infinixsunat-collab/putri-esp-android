<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content">

	<LinearLayout
		android:orientation="vertical"
		android:id="@+id/espView"
		android:background="@drawable/bg_menu"
		android:visibility="gone"
		android:layout_width="340dp"
		android:layout_height="wrap_content"
		android:alpha="1.0">

		<RelativeLayout
			android:background="@drawable/bg_buttontext"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center">

			<LinearLayout
				android:id="@+id/menu_pertama"
				android:orientation="horizontal"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center">

				<TextView
					android:text="Putri Esp"
					android:textAppearance="?android:attr/textAppearanceSmall"
					android:textStyle="bold"
					android:textColor="#FF000000"
					android:gravity="center_vertical"
					android:id="@+id/textView4"
					android:layout_width="290dp"
					android:layout_height="wrap_content"
					android:layout_marginTop="0.0dp"
					android:layout_marginBottom="0.0dp"
					android:layout_marginStart="15.0dp"/>

				<TextView
					android:id="@+id/closeBtn"
					android:layout_width="30dp"
					android:layout_height="wrap_content"
					android:text="×"
					android:textAppearance="?android:attr/textAppearanceLarge"
					android:gravity="center"
					android:layout_marginLeft="5dp"
					android:textStyle="bold"
					android:textColor="#FF000000"
					android:translationY="-2dp"
					android:translationX="4dp"/>

			</LinearLayout>

		</RelativeLayout>

		<RelativeLayout
			android:background="#FFFFFFFF"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="0.0dp"
			android:gravity="center">

			<HorizontalScrollView
				android:scrollbarSize="0dp"
				android:scrollbars="horizontal|vertical"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content">

				<LinearLayout
					android:id="@+id/menu_pilihan"
					android:orientation="horizontal"
					android:layout_width="300dp"
					android:layout_height="wrap_content"
					android:gravity="center">

					<TextView
						android:id="@+id/menu_1"
						android:clickable="true"
						android:focusable="true"
						android:foreground="?android:attr/selectableItemBackground"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:text="Player"
						android:textSize="16sp"
						android:gravity="center"
						android:textColor="#FF000000"
						android:layout_marginLeft="15dp"
						android:layout_marginTop="10dp"
						android:paddingLeft="10dp"
						android:paddingRight="10dp"/>

					<TextView
						android:id="@+id/menu_3"
						android:clickable="true"
						android:focusable="true"
						android:foreground="?android:attr/selectableItemBackground"
						android:layout_width="wrap_content"
						android:layout_height="40dp"
						android:text="Setting"
						android:textSize="16sp"
						android:layout_marginLeft="8dp"
						android:layout_marginRight="15dp"
						android:gravity="center"
						android:textColor="#FF000000"
						android:layout_marginTop="10dp"
						android:paddingLeft="10dp"
						android:paddingRight="10dp"/>

				</LinearLayout>

			</HorizontalScrollView>

		</RelativeLayout>

		<LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="0.7dp"
			android:layout_marginLeft="10dp"
			android:layout_marginRight="10dp"
			android:background="#FF000000"/>

		<LinearLayout
			android:orientation="horizontal"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:id="@+id/inilagi_apa">

			<ScrollView
				android:layout_width="match_parent"
				android:layout_height="wrap_content">

				<LinearLayout
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:id="@+id/apasih_ini">

					<LinearLayout
						android:orientation="vertical"
						android:id="@+id/players"
						android:visibility="visible"
						android:layout_width="330dp"
						android:layout_height="match_parent"
						android:layout_marginLeft="10dp">

						<Button
							android:layout_width="match_parent"
							android:layout_height="40dp"
							android:backgroundTint="#ffffffff"
							android:text="TAP TO ENABLE ESP"
							android:visibility="visible"
							android:id="@+id/Count1"
							android:textStyle="bold"
							android:textColor="#FF32A852"
							android:layout_marginRight="10dp"/>
						
						<Button
							android:layout_width="match_parent"
							android:layout_height="40dp"
							android:backgroundTint="#ffffffff"
							android:text="Welcome To Mobile Legends"
							android:visibility="visible"
							android:id="@+id/switchcrash"
							android:textStyle="bold"
							android:textColor="#FF32A852"
							android:layout_marginRight="10dp"/>
						
						

						<LinearLayout
							android:orientation="vertical"
							android:layout_width="match_parent"
							android:layout_height="wrap_content">

							<Switch
								android:id="@+id/Count"
								android:textSize="15.0dp"
								android:textColor="#FF000000"					
								android:layout_width="325dp"
								android:layout_height="35dp"
								android:thumb="@drawable/thumb"
								android:text="Show count"
								android:theme="@style/SCBSwitch"/>

							<LinearLayout
								android:orientation="vertical"
								android:layout_width="match_parent"
								android:layout_height="1dp"
								android:layout_marginRight="10dp"
								android:background="#FF000000"/>

							<Switch
								android:textSize="15.0dp"
								android:textColor="#FF000000"
								android:id="@+id/isBox"
								android:layout_width="325dp"
								android:layout_height="35dp"
								android:thumb="@drawable/thumb"
								android:text="Box"
								android:theme="@style/SCBSwitch"/>

							<LinearLayout
								android:orientation="vertical"
								android:layout_width="match_parent"
								android:layout_height="1dp"
								android:layout_marginRight="10dp"
								android:background="#FF000000"/>

							<Switch
								android:textSize="15.0dp"
								android:textColor="#FF000000"
								android:id="@+id/isLine"
								android:layout_width="325dp"
								android:layout_height="35dp"
								android:thumb="@drawable/thumb"
								android:text="Line"
								android:theme="@style/SCBSwitch"/>

							<LinearLayout
								android:orientation="vertical"
								android:layout_width="match_parent"
								android:layout_height="1dp"
								android:layout_marginRight="10dp"
								android:background="#FF000000"/>

							<Switch
								android:textSize="15.0dp"
								android:textColor="#FF000000"
								android:id="@+id/isDist"
								android:layout_width="325dp"
								android:layout_height="35dp"
								android:thumb="@drawable/thumb"
								android:text="Distance"
								android:theme="@style/SCBSwitch"/>

							<LinearLayout
								android:orientation="vertical"
								android:layout_width="match_parent"
								android:layout_height="1dp"
								android:layout_marginRight="10dp"
								android:background="#FF000000"/>

							<Switch
								android:textSize="15.0dp"
								android:textColor="#FF000000"
								android:id="@+id/isHealth"
								android:layout_width="325dp"
								android:layout_height="35dp"
								android:thumb="@drawable/thumb"
								android:text="Health"
								android:theme="@style/SCBSwitch"/>

							<LinearLayout
								android:orientation="vertical"
								android:layout_width="match_parent"
								android:layout_height="1dp"
								android:layout_marginRight="10dp"
								android:background="#FF000000"/>

							<Switch
								android:textSize="15.0dp"
								android:textColor="#FF000000"
								android:id="@+id/isName"
								android:layout_width="325dp"
								android:layout_height="35dp"
								android:thumb="@drawable/thumb"
								android:text="Name"
								android:theme="@style/SCBSwitch"/>

							<LinearLayout
								android:orientation="vertical"
								android:layout_width="match_parent"
								android:layout_height="1dp"
								android:layout_marginRight="10dp"
                                android:visibility="gone"
								android:background="#FF000000"/>

							<Switch
								android:textSize="15.0dp"
								android:textColor="#FF000000"
								android:id="@+id/Team"
								android:layout_width="325dp"
								android:layout_height="35dp"
								android:thumb="@drawable/thumb"
                                android:visibility="gone"
								android:text="Show Room Team"
								android:theme="@style/SCBSwitch"/>

							<LinearLayout
								android:orientation="vertical"
								android:layout_width="match_parent"
								android:layout_height="1dp"
                                android:visibility="gone"
								android:layout_marginRight="10dp"
								android:background="#FF000000"/>
							
							<Switch
							    android:textSize="15.0dp"
							    android:textColor="#FF000000"
							    android:id="@+id/TeamE"
							    android:layout_width="325dp"
                                android:visibility="gone"
							    android:layout_height="35dp"
							    android:thumb="@drawable/thumb"
							    android:text="Show Room Enemy"
							    android:theme="@style/SCBSwitch"/>

							<LinearLayout
								android:orientation="vertical"
								android:layout_width="match_parent"
								android:layout_height="1dp"
								android:layout_marginRight="10dp"
								android:background="#FF000000"/>

							<Switch
								android:textSize="15.0dp"
								android:textColor="#FF000000"
								android:id="@+id/isBack"
								android:layout_width="325dp"
								android:layout_height="35dp"
								android:thumb="@drawable/thumb"
								android:text="360° Alert"
								android:theme="@style/SCBSwitch"/>

							<LinearLayout
								android:orientation="vertical"
								android:layout_width="match_parent"
								android:layout_height="1dp"
								android:layout_marginRight="10dp"
								android:background="#FF000000"/>

							<Switch
								android:textSize="15.0dp"
								android:textColor="#Ff000000"
								android:id="@+id/skeleton"
								android:visibility="visible"
								android:layout_width="325dp"
								android:layout_height="35dp"
								android:thumb="@drawable/thumb"
								android:text="Cooldown"
								android:theme="@style/SCBSwitch"/>
											
							<TextView
								android:textSize="15.0dp"
								android:textColor="#FF000000"
								android:paddingLeft="6dp"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:text="Minimap Feature"
								android:textStyle="bold"
								android:textAlignment="gravity"/>
							
							<Switch
								android:textSize="15.0dp"
								android:textColor="#Ff000000"
								android:id="@+id/Radar"
								android:visibility="visible"
								android:layout_width="325dp"
								android:layout_height="35dp"
								android:thumb="@drawable/thumb"
								android:text="Draw Minimap"
								android:theme="@style/SCBSwitch"/>
							
							
							<LinearLayout
								android:orientation="horizontal"
								android:layout_width="fill_parent"
								android:layout_height="30dp">

								<TextView
									android:id="@+id/MiniPosText"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:gravity="center_vertical"
									android:text="0"
									android:textAlignment="gravity"
									android:textColor="#FFFFFF"/>

								<SeekBar
									android:id="@+id/MiniPos"
									android:layout_width="match_parent"
									android:layout_height="match_parent"
									android:max="500"
									android:progress="105"
									android:theme="@style/SCBSwitch"/>

							</LinearLayout>
							
							<LinearLayout
								android:orientation="horizontal"
								android:layout_width="fill_parent"
								android:layout_height="30dp">

								<TextView
									android:id="@+id/MiniSizeText"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:gravity="center_vertical"
									android:text="0"
									android:textAlignment="gravity"
									android:textColor="#FFFFFF"/>

								<SeekBar
									android:id="@+id/MiniSize"
									android:layout_width="match_parent"
									android:layout_height="match_parent"
									android:max="1000"
									android:progress="340"
									android:theme="@style/SCBSwitch"/>

							</LinearLayout>
							
							<LinearLayout
								android:orientation="horizontal"
								android:layout_width="fill_parent"
								android:layout_height="30dp">

								<TextView
									android:id="@+id/IconSizeText"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:gravity="center_vertical"
									android:text="0"
									android:textAlignment="gravity"
									android:textColor="#FFFFFF"/>

								<SeekBar
									android:id="@+id/IconSize"
									android:layout_width="match_parent"
									android:layout_height="match_parent"
									android:max="1000"
									android:progress="140"
									android:theme="@style/SCBSwitch"/>

							</LinearLayout>
							
							<TextView
								android:textSize="15.0dp"
								android:textColor="#FF000000"
								android:paddingLeft="6dp"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:text="Memory Feature"
								android:textStyle="bold"
								android:textAlignment="gravity"/>
							
							<Switch
								android:textSize="15.0dp"
								android:textColor="#Ff000000"
								android:id="@+id/Drone"
								android:visibility="visible"
								android:layout_width="325dp"
								android:layout_height="35dp"
								android:thumb="@drawable/thumb"
								android:text="Drone"
								android:theme="@style/SCBSwitch"/>
							
							<LinearLayout
								android:orientation="horizontal"
								android:layout_width="fill_parent"
								android:layout_height="30dp">

								<TextView
									android:id="@+id/droneHText"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:gravity="center_vertical"
									android:text="0"
									android:textAlignment="gravity"
									android:textColor="#FFFFFF"/>

								<SeekBar
									android:id="@+id/droneH"
									android:layout_width="match_parent"
									android:layout_height="match_parent"
									android:max="30"
									android:progress="0"
									android:theme="@style/SCBSwitch"/>

							</LinearLayout>

						</LinearLayout>

					</LinearLayout>

					<LinearLayout
						android:orientation="vertical"
						android:id="@+id/settings"
						android:padding="10dp"
						android:visibility="gone"
						android:layout_width="match_parent"
						android:layout_height="match_parent">

						<ScrollView
							android:layout_width="fill_parent"
							android:layout_height="fill_parent">

							<LinearLayout
								android:orientation="vertical"
								android:id="@+id/Settings1"
								android:layout_width="fill_parent"
								android:layout_height="fill_parent">

								<TextView
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:paddingLeft="6dp"
									android:text="Hide icons"
									android:textStyle="bold"
									android:textSize="15dp"
									android:textColor="#FF000000"/>

								<LinearLayout
									android:orientation="horizontal"
									android:layout_width="fill_parent"
									android:layout_height="30dp">

									<SeekBar
										android:id="@+id/hide"
										android:layout_width="match_parent"
										android:layout_height="match_parent"
										android:max="5"
										android:min="-255"
										android:progress="5"
										android:theme="@style/SCBSwitch"/>

								</LinearLayout>

								<TextView
									android:textSize="15.0dp"
									android:textColor="#FF000000"
									android:paddingLeft="6dp"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:text="Render framerate"
									android:textStyle="bold"
									android:textAlignment="gravity"/>

								<RadioGroup
									android:id="@+id/rgFps"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:orientation="vertical">

									<RadioButton
										android:id="@+id/fps30"
										android:tag="120"
										android:checked="true"
										android:textSize="14sp"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:text="120 FPS"
										android:textColor="#FF000000"
										android:theme="@style/SCBSwitch"/>

									<RadioButton
										android:id="@+id/fps60"
										android:tag="90"
										android:textSize="14sp"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:text="90 FPS"
										android:textColor="#FF000000"
										android:theme="@style/SCBSwitch"/>

									<RadioButton
										android:id="@+id/fps90"
										android:tag="60"
										android:textSize="14sp"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:text="60 FPS"
										android:textColor="#FF000000"
										android:theme="@style/SCBSwitch"/>

									<RadioButton
										android:id="@+id/fps120"
										android:tag="30"
										android:textSize="14sp"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:text="30 FPS"
										android:textColor="#FF000000"
										android:theme="@style/SCBSwitch"/>

								</RadioGroup>

							</LinearLayout>

						</ScrollView>

					</LinearLayout>

				</LinearLayout>

			</ScrollView>

		</LinearLayout>

	</LinearLayout>

	<RelativeLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content">

		<RelativeLayout
			android:id="@+id/relativeLayoutParent"
			android:orientation="vertical"
			android:padding="0.0dp"
			android:visibility="visible"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content">

			<ImageView
				android:id="@+id/floatLogo"
				android:layout_width="40.0dp"
				android:layout_height="40.0dp"
				android:src="@drawable/icon"
				android:scaleType="fitCenter"/>

		</RelativeLayout>

	</RelativeLayout>

</FrameLayout>

