<?xml version="1.0" encoding="utf-8"?> 
<selector xmlns:android="http://schemas.android.com/apk/res/android"> 
    <item android:state_checked="true"> 
        <shape
			android:dither="true"
			android:visible="true"
			android:useLevel="false">
            <corners
				android:radius="50dp"/> 
            <solid
				android:color="#FF2196F3"/>
			<size
				android:width="21dp"
				android:height="21dp"/> 
        </shape> 
    </item> 
	
    <item android:state_checked="false"> 
        <shape 
			android:dither="true"
			android:visible="true"
			android:useLevel="false"> 
            <corners 
				android:radius="50dp"/> 
            <solid
				android:color="#FF424242"/>
			<size 
				android:width="21dp"
				android:height="21dp" /> 
        </shape> 
    </item> 
</selector>
